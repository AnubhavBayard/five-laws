{
  "name": "five-laws",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "cp node_modules/sql.js/dist/sql-wasm.wasm public/assets/sql-wasm.wasm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && cap sync android && cap run android",
    "eval": "node scripts/eval-steps.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@ionic/react": "9.0.12",
    "@ionic/react-router": "9.0.12",
    "@supabase/supabase-js": "2.119.1",
    "ionicons": "8.1.0",
    "jeep-sqlite": "2.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "sql.js": "1.11.0",
    "supabase": "3.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
